# Cabbie v2.0 statusbar - 480x640 (PodBox / Surfans F20 Pro+)
# (C) 2007-2012 The Authors (see /rockbox/wps/AUTHORS)
# Based on classic_statusbar.24.sbs, everything at twice the size
# (icons scaled 2x, nearest neighbour) so it is readable on the 480x640
# screen. Bar height 44 px.

# UI area: everything below the bar
%Vi(-,0,44,-,-,1)

%Fl(2,27-Adobe-Helvetica.fnt)

# Conditional for showing volume as number or graphic
%?if(%St(volume display), =, numeric)<%Vd(d)|%Vd(c)>

# Conditional for showing battery as number or graphic
%?if(%St(battery display), =, numeric)<%Vd(b)|%Vd(a)%Vd(e)>

%xl(B,sb-battery-480x640x16.bmp,0,0,16)
%xl(V,sb-volume-480x640x16.bmp,0,0,17)
%xl(S,sb-status-480x640x16.bmp,0,0,15)
%xl(y,sb-batter-y-480x640x16.bmp,0,0)

%Vd(p)%Vd(r)%Vd(s)

# Charging animation viewports
%t(2)%?bc<%Vd(x)|%Vd(a)>;%t(2)%Vd(a)

# Battery, icon
%Vl(a,10,8,68,28,0)
%?bl<%xd(Ba)|%xd(Bb)|%xd(Bc)|%xd(Bd)|%xd(Be)|%xd(Bf)|%xd(Bg)|%xd(Bh)|%xd(Bi)|%xd(Bj)|%xd(Bk)|%xd(Bl)|%xd(Bm)|%xd(Bn)|%xd(Bo)>

# Battery, grey background for the charging animation
%Vl(x,10,8,68,28,0)%Vb(555555)

# end of the battery symbol (not animated)
%Vl(e,78,8,4,28,0)
%xd(y)

# usb power or charger icon
%V(88,6,28,32,0)
%?bu<%xd(Sa)|%?bc<%xd(Sa)|%?bp<%xd(So)>>>

# Battery, as number
%Vl(b,10,6,100,32,2)
%al%bl%%

# Volume, icon
%Vl(c,130,8,56,28,0)
%?pv<%xd(Va)|%xd(Vb)|%xd(Vc)|%xd(Vd)|%xd(Ve)|%xd(Vf)|%xd(Vg)|%xd(Vh)|%xd(Vi)|%xd(Vj)|%xd(Vk)|%xd(Vl)|%xd(Vm)|%xd(Vn)|%xd(Vo)|%xd(Vp)|%xd(Vq)>
# Volume, as number
%Vl(d,120,6,110,32,2)
%ac%pv

# Playback status
%Vl(p,236,6,28,32,0)
%?mp<%xd(Sc)|%xd(Sb)|%xd(Sd)|%xd(Se)|%xd(Sf)|%xd(Sg)|%xd(Sh)|%xd(Si)|%xd(Sj)>

# Repeat mode
%Vl(r,272,6,28,32,0)
%?mm<|%xd(Sk)|%xd(Sl)|%xd(Sm)|%xd(Sn)>

# Shuffle mode
%Vl(s,308,6,28,32,0)
%?ps<%xd(Sm)|>

# Clock
%V(-140,6,130,32,2)
%ar%?cc<%?ca<%?St(time format)<%cH|%cI>:%cM|--:-->|>
