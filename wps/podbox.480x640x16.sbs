# mini player
#
%Vl(art,26,555,64,64,-)
%Cd
%Vl(noart,26,555,64,64,-)
%xd(mnone)
%Vl(play,104,559,304,29,7)
%?it<%it|%fn>
%Vl(play,104,591,304,25,4)%Vf(A8ACB0)
%?ia<%ia|%?iA<%iA|%?d(2)<%d(2)|>>>
%Vl(play,422,573,28,28,-)
