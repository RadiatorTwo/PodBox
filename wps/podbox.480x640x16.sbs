# PodBox - menus and lists, 480x640 (Surfans F20 Pro+)
# Status bar, list title, list area and a mini player at the bottom.
# The mini player card is part of the backdrop (podbox/theme/mkassets.py).
# The selected list line is drawn as a card by apps/gui/line.c
# (selector type "bar (color)", colours from the theme .cfg).
%X(sbs-backdrop.bmp)

%Fl(2,36-Inter-Bold.fnt)
%Fl(4,24-Inter.fnt)
%Fl(5,22-Inter-SemiBold.fnt)
%Fl(7,28-Inter-SemiBold.fnt)

%xl(playmode,st-playmode.bmp,0,0,3)
%xl(shuf,st-shuffle.bmp,0,0)
%xl(repeat,st-repeat.bmp,0,0,3)
%xl(battery,st-battery.bmp,0,0,11)
%xl(mnone,mini-none.bmp,0,0)
%xl(minitrack,mini-track.bmp,0,0)
%xl(miniplay,mini-playmode.bmp,0,0,3)

%Cl(0,0,64,64,c,c)

# list area: below the title, above the mini player
%Vi(-,12,92,456,448,1)

%?mp<%Vd(idle)|%Vd(play)|%Vd(play)|%Vd(play)|%Vd(play)|%Vd(idle)|%Vd(idle)|%Vd(idle)|%Vd(idle)>
%?C<%Vd(art)|%Vd(noart)>

#
# status bar
#
%V(16,7,20,20,-)
%?mp<%xd(playmode,3)|%xd(playmode,1)|%xd(playmode,2)|%xd(playmode,1)|%xd(playmode,1)|%xd(playmode,3)|%xd(playmode,3)|%xd(playmode,3)|%xd(playmode,3)>
%V(42,7,20,20,-)
%?ps<%xd(shuf)|>
%V(66,7,20,20,-)
%?mm<|%xd(repeat,1)|%xd(repeat,2)|%xd(repeat,3)|%xd(repeat,1)>
%V(140,5,200,23,5)
%ac%?cc<%?ca<%?St(time format)<%cH|%cI>:%cM|>|>
%V(316,5,114,23,5)%Vf(A8ACB0)
%ar%bl %%
%V(436,8,28,16,-)
%?bl<%xd(battery,1)|%xd(battery,1)|%xd(battery,2)|%xd(battery,3)|%xd(battery,4)|%xd(battery,5)|%xd(battery,6)|%xd(battery,7)|%xd(battery,8)|%xd(battery,9)|%xd(battery,10)|%xd(battery,11)>

#
# list title
#
%V(28,44,424,38,2)
%Lt

